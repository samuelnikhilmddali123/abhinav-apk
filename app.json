{
  "expo": {
    "name": "Abhinav Gold and Silver",
    "slug": "jewllery-expo",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/Untitled design (2).png",
    "scheme": "jewelryexpo",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/Untitled design (2).png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "abhinav.com",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/Untitled design (2).png",
        "backgroundColor": "#000000"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a4085461-f537-43d4-8e23-2f4f8113c3c8"
      }
    }
  }
}
